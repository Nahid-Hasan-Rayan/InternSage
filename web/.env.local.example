# InternSage frontend — environment template
# Author: Nahid Hasan Rayan
#
# Copy to .env.local for local dev. On Vercel, set NEXT_PUBLIC_API_URL
# as a Project → Settings → Environment Variable instead (Production
# value = your deployed backend's URL, e.g. the backend Vercel
# project's URL, with NO trailing slash and no /api suffix — src/lib/api.ts
# appends /api itself).

# Local dev — points at the NestJS backend running via `npm run start:dev`.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Production example (backend deployed as its own Vercel project):
# NEXT_PUBLIC_API_URL=https://internsage-api.vercel.app
