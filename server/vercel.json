{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/internal/jobs/aggregate",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/internal/matching/recompute",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/verification/internal/decay",
      "schedule": "0 4 * * *"
    }
  ]
}