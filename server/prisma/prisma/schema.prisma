// ============================================================
//  InternSage — Database schema (Phase 1: Identity, Profile, CV)
// ------------------------------------------------------------
//  Design notes (see docs/InternSage_Master_Blueprint.md §5, §7):
//   - Verification is structural: a User is only ever `verified`
//     because their email domain matched a whitelisted
//     University/Company row, never by manual review.
//   - Academic and Professional profiles are separate tables
//     (not one wide nullable table) so each keeps its own
//     validation and business logic isolated — a deliberate
//     single-responsibility choice, not an oversight.
//   - Skill has a `category` so the CV schema stays field-aware
//     (Software / Mechanical / Business / ... ) instead of
//     assuming every student is a programmer.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase's PgBouncer connection pooler (port 6543) — required
  // for a serverless deployment (Vercel), since each function
  // invocation can open its own connection and a serverless app
  // exhausts Postgres's direct connection limit almost immediately
  // without pooling. Append `?pgbouncer=true&connection_limit=5` —
  // see README.md's Supabase setup section for the exact string.
  //
  // Do not "fix" this back down to
  // connection_limit=1. That looked like the safe, minimal value
  // and was the documented setting for a while, but it silently
  // serializes every concurrent query *within a single request* —
  // Prisma queues anything past 1 open connection behind it. Any
  // handler using Promise.all() for several queries at once
  // (DecisionRoomService.getTrends, UniversityService.getDashboard,
  // and others) was/is running those queries one at a time instead
  // of in parallel, on top of Vercel's own cold-start cost. 5 is
  // still conservative for PgBouncer in transaction-pooling mode —
  // it multiplexes many client-side connections over few real
  // Postgres ones exactly so a per-instance limit like this can be
  // higher than 1 without endangering the underlying database.
  url       = env("DATABASE_URL")
  // Supabase's DIRECT connection (port 5432), bypassing the pooler.
  // `prisma migrate` needs this — PgBouncer's transaction mode
  // doesn't support the prepared statements migrations rely on.
  // Only used at migration time, never by the running app.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------
// Enums
// ---------------------------------------------------------------

enum Role {
  STUDENT
  RECRUITER
  UNIVERSITY
  ADMIN
}

enum ProfileVisibility {
  ALL_VERIFIED_RECRUITERS
  APPLIED_ONLY
  DRAFT
}

enum SkillCategory {
  SOFTWARE
  MECHANICAL
  ELECTRICAL
  CHEMICAL
  BUSINESS
  ACCOUNTING
  ECONOMICS
  OTHER
}

// ---------------------------------------------------------------
// Identity
// ---------------------------------------------------------------

/// The single identity every profile hangs off. Never stores a
/// plaintext password — only a bcrypt hash (see AuthService).
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile       StudentProfile?
  professionalProfile  ProfessionalProfile?
  recruiterProfile     RecruiterProfile?
  universityAdminProfile UniversityAdminProfile?

  @@map("users")
}

/// Whitelisted university email domains. A registration whose
/// email domain matches a row here is auto-verified — this is
/// the entire trust mechanism, deliberately with no manual
/// review queue to staff.
model University {
  id          String   @id @default(uuid())
  name        String
  emailDomain String   @unique
  verified    Boolean  @default(true)
  createdAt   DateTime @default(now())

  studentProfiles StudentProfile[]
  adminProfiles   UniversityAdminProfile[]
  partners        UniversityPartner[]
  events          UniversityEvent[]

  @@map("universities")
}

/// Whitelisted company email domains — the recruiter-side mirror
/// of University above.
model Company {
  id          String   @id @default(uuid())
  name        String
  emailDomain String   @unique
  verified    Boolean  @default(true)
  /// Gates a recruiter's ability to send the FIRST message on a
  /// conversation (see MessagingService) — Handshake's proven
  /// anti-spam mechanism, per the Blueprint. Never affects matching.
  trustScore  Int      @default(100)
  createdAt   DateTime @default(now())

  recruiterProfiles RecruiterProfile[]
  jobPostings       JobPosting[]
  interviewKits     InterviewKit[]

  @@map("companies")
}

// ---------------------------------------------------------------
// Profiles (the academic ⇄ professional switch)
// ---------------------------------------------------------------

model StudentProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
  major        String?
  year         Int?
  bio          String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([universityId])
  @@map("student_profiles")
}

model ProfessionalProfile {
  id         String            @id @default(uuid())
  userId     String            @unique
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline   String?
  visibility ProfileVisibility @default(ALL_VERIFIED_RECRUITERS)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  experiences Experience[]
  educations  Education[]
  projects    Project[]
  skills      UserSkill[]

  @@map("professional_profiles")
}

model RecruiterProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId])
  @@map("recruiter_profiles")
}

// ---------------------------------------------------------------
// University portal
// ------------------------------------------------------------
//  UniversityAdminProfile mirrors RecruiterProfile -> Company
//  exactly on purpose: same "one profile row scoped to exactly one
//  tenant, resolved from the authenticated user, never a
//  client-supplied id" shape that already governs recruiter access.
//  See AuthService.register's UNIVERSITY branch — like RECRUITER
//  (and unlike STUDENT), an unmatched domain is REJECTED outright,
//  not let in unverified: a university admin sees cohort-wide
//  student data, which is a higher-trust surface than an individual
//  student's own profile.
// ---------------------------------------------------------------

model UniversityAdminProfile {
  id           String     @id @default(uuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([universityId])
  @@map("university_admin_profiles")
}

/// A curated directory entry the university admin adds by hand —
/// NOT auto-derived from job/application data (that's what
/// UniversityService's topCompanies computation is for, deliberately
/// kept separate; see its own header comment for why). "industry"
/// only exists here because neither Company nor JobPosting carries
/// an industry taxonomy today.
model UniversityPartner {
  id           String     @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  industry     String
  createdAt    DateTime   @default(now())

  @@index([universityId])
  @@map("university_partners")
}

model UniversityEvent {
  id           String     @id @default(uuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  title        String
  date         DateTime
  createdAt    DateTime   @default(now())

  @@index([universityId])
  @@index([date])
  @@map("university_events")
}

// ---------------------------------------------------------------
// Observability — analytics events & error log
// ------------------------------------------------------------
//  Design notes (see docs/MONITORING.md):
//   - AnalyticsEvent is a single append-only table for both
//     automatic request telemetry (type=REQUEST, written by the
//     global interceptor) and deliberate product events (signup,
//     login, profile_completed, ...) so "how are people using
//     this" and "is this thing healthy" share one queryable log
//     instead of two disconnected systems.
//   - userId is nullable and has no relation/onDelete constraint
//     on purpose: deleting a user must never be blocked by, or
//     cascade-delete, historical analytics — the event log
//     outlives the account.
//   - ErrorLog is separate from AnalyticsEvent (not just an event
//     type) because errors need a longer retention policy and a
//     different access pattern (triage by route/message, not by
//     user funnel) — see AnalyticsService.
// ---------------------------------------------------------------

enum AnalyticsEventType {
  REQUEST
  AUTH_REGISTER
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  PROFILE_UPDATED
  CV_UPDATED
  JOB_POSTING_CREATED
  MATCHES_RECOMPUTED
  VERIFICATION_COMPLETED
  APPLICATION_STATUS_CHANGED
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  type       AnalyticsEventType
  userId     String?
  userRole   Role?
  path       String?
  method     String?
  statusCode Int?
  durationMs Int?
  metadata   Json?
  createdAt  DateTime           @default(now())

  @@index([type, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

model ErrorLog {
  id         String   @id @default(uuid())
  message    String
  stack      String?
  path       String?
  method     String?
  statusCode Int
  requestId  String
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@map("error_logs")
}

// ---------------------------------------------------------------
// Phase 2/3 — Job aggregation, matching, trust & verification
// ------------------------------------------------------------
//  Design notes (see ARCHITECTURE.md's Phase 2 section and the
//  Master Blueprint §5/§10):
//   - JobPosting.dedupHash (sha256 of title+companyId+externalUrl,
//     see JobsService.computeDedupHash) is the actual dedup
//     guarantee — enforced with a DB-level unique constraint, not
//     just "remembered" in application code, so a re-run of the
//     aggregator or a recruiter re-posting the same role can never
//     silently double-insert.
//   - `source` defaults to MANUAL: a recruiter posting directly
//     through JobsController never needs to claim a source — only
//     AggregatorService explicitly sets RSS/SCRAPED/API.
//   - JobRequiredSkill (not free-text parsing) is what makes
//     MatchScore's matchedSkills/missingSkills a real set
//     intersection instead of a guess — explainability requires the
//     structure to actually exist, not just be inferred after the
//     fact.
//   - MatchScore is v1: skill-overlap (real intersection) blended
//     with a lightweight text-similarity signal (see
//     common/embeddings/embedding.util.ts) under a per-company
//     configurable rubric (RecruiterWeights). This is NOT yet the
//     Blueprint's target pgvector/sentence-transformers architecture
//     — that needs a separate ai-service this project doesn't have
//     yet. Labelled honestly rather than pretending otherwise.
//   - VerificationSession stores `questionIds`/`answers` as native
//     Postgres arrays rather than a join table — one row per
//     attempt is suffient here (nothing else needs to query "all
//     answers to question X" as its own access pattern), and it
//     keeps submitSession's read/write down to one row instead of N.
//     Timing (`expiresAt`) is always checked server-side, per the
//     Build Plan's own Interview Training principle applied here.
// ---------------------------------------------------------------

enum JobSource {
  MANUAL
  API
  RSS
  SCRAPED
}

enum VerificationStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

/// A listing — either posted directly by a verified recruiter
/// (source=MANUAL) or aggregated from an external source, which
/// always retains externalUrl so a click-through respects the
/// original rather than trapping the student inside InternSage.
model JobPosting {
  id               String      @id @default(uuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id])
  title            String
  description      String
  requirementsText String
  location         String?
  category         SkillCategory?
  source           JobSource   @default(MANUAL)
  externalUrl      String?
  dedupHash        String      @unique
  isActive         Boolean     @default(true)
  postedAt         DateTime    @default(now())
  createdAt        DateTime    @default(now())

  requiredSkills JobRequiredSkill[]
  applications   Application[]
  matchScores    MatchScore[]

  @@index([companyId])
  @@map("job_postings")
}

/// Structured (never free-text-parsed) required skills for a
/// posting — this is what lets MatchScore's explanation be an
/// actual set intersection instead of a guess.
model JobRequiredSkill {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skillId      String
  skill        Skill      @relation(fields: [skillId], references: [id])

  @@unique([jobPostingId, skillId])
  @@map("job_required_skills")
}

/// One student's application to one posting. `userId` (not
/// `studentProfileId`) is the ownership key — a service method
/// resolves "whose application is this" from the authenticated
/// user, never from a client-supplied id.
model Application {
  id           String            @id @default(uuid())
  userId       String
  jobPostingId String
  jobPosting   JobPosting        @relation(fields: [jobPostingId], references: [id])
  status       ApplicationStatus @default(APPLIED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  scorecards   Scorecard[]
  conversation Conversation?

  @@unique([userId, jobPostingId])
  @@index([userId])
  @@index([jobPostingId])
  @@map("applications")
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

/// Per-company configurable scoring rubric (Master Blueprint's
/// "Configurable Recruiter Scoring Rubric" — different employers
/// weight skills/projects/authenticity/soft-skills differently).
/// Absent for a company => MatchingService falls back to sensible
/// defaults; there's no config UI for this yet (Phase 3 recruiter
/// tooling), so today every row here has to be set by hand.
model RecruiterWeights {
  id                 String  @id @default(uuid())
  companyId          String  @unique
  skillsWeight       Float   @default(0.4)
  projectsWeight     Float   @default(0.2)
  authenticityWeight Float   @default(0.3)
  softSkillsWeight   Float   @default(0.1)

  @@map("recruiter_weights")
}

/// v1 explainable match score — see this section's header comment.
/// Computed only by MatchingService.recomputeForStudent, never live
/// on a page load; GET /matches only reads what was last computed.
model MatchScore {
  id                String     @id @default(uuid())
  studentProfileId  String
  jobPostingId      String
  jobPosting        JobPosting @relation(fields: [jobPostingId], references: [id])
  score             Int
  matchedSkills     Json
  missingSkills     Json
  computedAt        DateTime   @default(now())

  @@unique([studentProfileId, jobPostingId])
  @@index([studentProfileId])
  @@map("match_scores")
}

/// Seeded question bank — original or openly-licensed content only,
/// per the Blueprint ("never scrape a proprietary bank"). Correct
/// answers never leave VerificationService for the client to see
/// ahead of submission.
model VerificationQuestion {
  id           String @id @default(uuid())
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  prompt       String
  choices      Json
  correctIndex Int

  @@index([skillId])
  @@map("verification_questions")
}

/// One bounded, consented, timed quiz attempt tied to a claimed
/// skill (UserSkill, not Skill directly — verification is scoped to
/// THIS student's specific claim). Deliberately NOT ambient
/// behavioral monitoring — see the Blueprint's Trust & Verification
/// section for why. `expiresAt` is always checked server-side,
/// never trusting a client-reported elapsed time.
model VerificationSession {
  id          String              @id @default(uuid())
  userSkillId String
  userSkill   UserSkill           @relation(fields: [userSkillId], references: [id], onDelete: Cascade)
  questionIds String[]
  answers     Int[]
  status      VerificationStatus  @default(IN_PROGRESS)
  score       Int?
  startedAt   DateTime            @default(now())
  expiresAt   DateTime
  completedAt DateTime?

  @@index([userSkillId])
  @@map("verification_sessions")
}

// ---------------------------------------------------------------
// Phase 3 — Recruiter tooling: structured interview kits & scorecards
// ------------------------------------------------------------
//  Design notes (Master Blueprint §5, "Structured Interview Kits &
//  Scorecards" — modeled on Greenhouse's bias-reduction thesis):
//   - One InterviewKit per (company, role title) is reused across
//     every candidate for that role — this is what makes evaluation
//     comparable instead of ad hoc. It's not per-application.
//   - Scorecard is per-application, always against a specific kit,
//     so "what were they evaluated on" is always reconstructable —
//     never a bare number with no rubric behind it.
//   - recommendation is a small closed enum (not free text) so
//     recruiter dashboards can aggregate/filter on it reliably.
// ---------------------------------------------------------------

enum ScorecardRecommendation {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}

model InterviewKit {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  roleTitle String
  criteria  Json
  createdAt DateTime @default(now())

  scorecards Scorecard[]

  @@unique([companyId, roleTitle])
  @@map("interview_kits")
}

model Scorecard {
  id             String                  @id @default(uuid())
  applicationId  String
  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewKitId String
  interviewKit   InterviewKit            @relation(fields: [interviewKitId], references: [id])
  submittedById  String
  ratings        Json
  notes          String?
  recommendation ScorecardRecommendation
  createdAt      DateTime                @default(now())

  @@index([applicationId])
  @@map("scorecards")
}

// ---------------------------------------------------------------
// CV building blocks
// ---------------------------------------------------------------

model Skill {
  id       String        @id @default(uuid())
  name     String        @unique
  category SkillCategory @default(OTHER)

  userSkills UserSkill[]
  jobRequiredSkills    JobRequiredSkill[]
  verificationQuestions VerificationQuestion[]
  demandSnapshots       SkillDemandSnapshot[]

  @@map("skills")
}

/// The join between a profile and a skill. `verified` and
/// `authenticityScore` start false/null and are only ever set by
/// VerificationService's submitSession/decayAllScores — never
/// settable directly by the client (there's no PATCH exposing
/// these fields anywhere in CvController).
model UserSkill {
  id                     String    @id @default(uuid())
  professionalProfileId  String
  professionalProfile    ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  skillId                String
  skill                  Skill     @relation(fields: [skillId], references: [id])
  verified               Boolean   @default(false)
  authenticityScore      Int?
  authenticityUpdatedAt  DateTime?
  createdAt              DateTime  @default(now())

  verificationSessions VerificationSession[]

  @@unique([professionalProfileId, skillId])
  @@map("user_skills")
}

model Experience {
  id                    String    @id @default(uuid())
  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  title                 String
  organization          String
  startDate             DateTime
  endDate               DateTime?
  description           String?

  @@index([professionalProfileId])
  @@map("experiences")
}

model Education {
  id                    String   @id @default(uuid())
  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  institution           String
  degree                String
  startYear             Int
  endYear               Int?
  verified              Boolean  @default(false)

  @@index([professionalProfileId])
  @@map("educations")
}

/// `portfolioUrl` is deliberately generic (not "githubUrl") so it
/// can hold a repo link, a CAD file, or a case-competition writeup
/// depending on the student's field — see the field-aware CV
/// reasoning in the Master Blueprint.
model Project {
  id                    String   @id @default(uuid())
  professionalProfileId String
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  title                 String
  description           String?
  portfolioUrl          String?

  @@index([professionalProfileId])
  @@map("projects")
}

// ---------------------------------------------------------------
// Audit trail — Sage Copilot queries (blocked or not), and any
// future action that needs "what happened and why" reconstructable
// after the fact, per the Blueprint's explainability requirement.
// ---------------------------------------------------------------

// ---------------------------------------------------------------
// Phase 3 — Messaging
// ------------------------------------------------------------
//  REST + short client-side polling, not Socket.io: Vercel's
//  serverless functions don't hold a persistent connection open
//  the way a WebSocket gateway needs, so the Blueprint's Socket.io
//  design doesn't fit this project's actual hosting target. Every
//  Conversation is tied 1:1 to an Application (never a freestanding
//  DM) — messaging only exists in the context of a specific role.
// ---------------------------------------------------------------

model Conversation {
  id            String      @id @default(uuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// Decision Room — market-intelligence backing data
// ------------------------------------------------------------
//  Design notes (mirrors the MatchScore precedent: never computed
//  live on a page load):
//   - SkillDemandSnapshot is 100% derived from InternSage's own
//     JobPosting/JobRequiredSkill data (real postings this platform
//     has, not a scraped or invented labour-market figure) — see
//     DecisionRoomService.recomputeSkillDemand, called only by the
//     internal cron route, same pattern as MatchingService/
//     VerificationService's own recompute/decay jobs. GET
//     /decision-room/trends only ever reads the latest stored rows.
//     Early on, with few postings, these numbers will be small and
//     sparse — that's honest, not a bug to paper over.
//   - SalaryBenchmark is the opposite kind of data on purpose: it's
//     NOT computable from InternSage's own (currently too-thin)
//     posting volume, so it is curated, source-attributed reference
//     data (see prisma/seed.ts), following the same
//     "verified-outlet allowlist" principle the Industry Pulse
//     module is meant to use — never a fabricated number, always
//     traceable to a named, dated public source.
// ---------------------------------------------------------------

model SkillDemandSnapshot {
  id           String   @id @default(uuid())
  skillId      String
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  /// ISO week label, e.g. "2026-W33" — see decision-room.util.ts's
  /// isoWeekLabel, the same bucketing DecisionRoomTrends.skillDemand
  /// points render on the frontend's line chart.
  period       String
  postingCount Int
  computedAt   DateTime @default(now())

  @@unique([skillId, period])
  @@index([period])
  @@map("skill_demand_snapshots")
}

/// role+region is the natural key a recruiter/student would look
/// this up by — see prisma/seed.ts for the initial seeded rows and
/// their cited source.
model SalaryBenchmark {
  id        String   @id @default(uuid())
  role      String
  region    String
  p25       Int
  median    Int
  p75       Int
  /// Named source this row came from, e.g. "Randstad Malaysia —
  /// 2025 Job Market Outlook & Salary Guide" — never blank, never
  /// "estimated".
  source    String
  asOf      DateTime
  updatedAt DateTime @updatedAt

  @@unique([role, region])
  @@map("salary_benchmarks")
}
